# coding_agent 环境变量模板。
# 复制为 .env 并填入真实值;.env 已被 .gitignore,不会提交入库。
# 若本文件被误提交了真实密钥,请立即作废更换密钥。

# 默认厂商 DeepSeek(与 config.yaml 的 base_url 对应)
DEEPSEEK_API_KEY=sk-你的key

# 若改用其它 OpenAI 兼容厂商,改 config.yaml 的 base_url 并设置对应变量:
# OPENAI_API_KEY=sk-...
# MOONSHOT_API_KEY=sk-...
# DASHSCOPE_API_KEY=sk-...
# ZHIPUAI_API_KEY=...
